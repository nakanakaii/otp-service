{
    "name": "nakanakaii/otp-service",
    "description": "Reusable OTP verification package for Laravel with polymorphic support and event-driven delivery",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Dahan",
            "email": "ahmed.dahan.ali@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nakanakaii\\OtpService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nakanakaii\\OtpService\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nakanakaii\\OtpService\\OtpServiceProvider"
            ],
            "aliases": {
                "Otp": "Nakanakaii\\OtpService\\OtpFacade"
            }
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
